# LedgerLens AI configuration

# Directory containing DD-WCP-003_FactMonthlyPL.csv
LEDGERLENS_DATA_DIR=/path/to/your/dataset

# Model-selection artifact
LEDGERLENS_SELECTION_FILE=./experiments/selected_forecasting_models.csv

# Optional project root
LEDGERLENS_PROJECT_ROOT=.

# Optional Gemini-backed financial reasoning. Keep real credentials in .env.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
GROQ_API_KEY=your_groq_api_key_here
